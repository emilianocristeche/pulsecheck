# Backend (loaded automatically from backend/.env or the repo-root .env)
DATABASE_URL=sqlite:///./pulsecheck.db
# Dashboard origin(s) allowed by CORS, comma-separated. Default: * (any).
CORS_ORIGINS=*
# Monitored URLs must resolve to public IPs (SSRF protection). Set to true to
# allow localhost / private-network targets on purpose.
PULSECHECK_ALLOW_PRIVATE_TARGETS=false

# Email alerts (optional — leave blank to disable)
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_PASSWORD=

# Frontend (set this on Vercel)
VITE_API_URL=https://your-api.onrender.com
